+function assert(cond, msg) {
+  if (!cond) { console.error('FAIL:', msg); process.exit(1); }
+}
+
+assert(isLoginEnabled(undefined) === true, 'unset => open (local default)');
+assert(isLoginEnabled('') === true, 'empty => open');
+assert(isLoginEnabled('false') === false, 'false => closed');
+assert(isLoginEnabled('0') === false, '0 => closed');
+assert(isLoginEnabled('off') === false, 'off => closed');
+assert(isLoginEnabled('true') === true, 'true => open');
+console.log('PASS: login-status kill switch');
+"
