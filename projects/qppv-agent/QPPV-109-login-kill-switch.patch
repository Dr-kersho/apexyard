diff --git a/frontend/src/app/api/login-status/route.ts b/frontend/src/app/api/login-status/route.ts
new file mode 100644
index 0000000..0e7f426
--- /dev/null
+++ b/frontend/src/app/api/login-status/route.ts
@@ -0,0 +1,22 @@
+import { NextResponse } from "next/server";
+
+export const dynamic = "force-dynamic";
+
+/** Parse LOGIN_ENABLED env (Vercel + local). Default true so local/dev keeps working. */
+export function isLoginEnabled(raw: string | undefined): boolean {
+  if (raw === undefined || raw === "") return true;
+  const v = raw.trim().toLowerCase();
+  if (["0", "false", "no", "off"].includes(v)) return false;
+  if (["1", "true", "yes", "on"].includes(v)) return true;
+  return true;
+}
+
+export async function GET(): Promise<NextResponse> {
+  const enabled = isLoginEnabled(process.env.LOGIN_ENABLED);
+  return NextResponse.json({
+    login_enabled: enabled,
+    detail: enabled
+      ? "Login open"
+      : "Login is temporarily closed by the operator.",
+  });
+}
