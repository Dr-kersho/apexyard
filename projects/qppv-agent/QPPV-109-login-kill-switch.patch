+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+node --experimental-strip-types --input-type=module -e "
+import { isLoginEnabled } from 'file://${ROOT}/src/app/api/login-status/route.ts';
