+#!/usr/bin/env bash
+# Self-check: suspended must never be classified as cold-start warming.
+# Uses Node 22+ type stripping — no test framework.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+node --experimental-strip-types --input-type=module -e "
+import {
+  classifyUpstreamHealth,
+  isRenderSuspended,
+} from 'file://${ROOT}/src/lib/upstream-health.ts';
+
+function assert(cond, msg) {
+  if (!cond) {
+    console.error('FAIL:', msg);
+    process.exit(1);
+  }
+}
+
+assert(
+  isRenderSuspended({ 'x-render-routing': 'suspend' }, ''),
+  'header suspend detection'
+);
+assert(
+  isRenderSuspended({}, '<title>Service Suspended</title>'),
+  'HTML suspend detection'
+);
+
+let r = classifyUpstreamHealth({
+  ok: false,
+  status: 503,
+  headers: { 'x-render-routing': 'suspend' },
+  bodyText: '<html><title>Service Suspended</title></html>',
+});
+assert(r.payload.status === 'suspended', 'suspended must not be warming');
+assert(r.httpStatus === 503, 'suspended http 503');
+
+r = classifyUpstreamHealth({
+  ok: false,
+  status: 503,
+  headers: {},
+  bodyText: 'Gateway Timeout',
+});
+assert(r.payload.status === 'warming', 'plain 503 without suspend => warming');
+
+r = classifyUpstreamHealth({
+  ok: true,
+  status: 200,
+  headers: { 'content-type': 'application/json' },
+  bodyText: JSON.stringify({ status: 'ok', version: '0.1.0' }),
+});
+assert(r.payload.status === 'ok' && r.payload.version === '0.1.0', 'ok path');
+
+r = classifyUpstreamHealth({
+  ok: false,
+  status: 503,
+  headers: {},
+  bodyText: '<html>Service Suspended</html>',
+});
+assert(r.payload.status === 'suspended', 'body Service Suspended => suspended');
+
+console.log('PASS: upstream-health classification');
+"
