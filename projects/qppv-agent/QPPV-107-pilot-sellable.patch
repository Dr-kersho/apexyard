@@ -0,0 +1,107 @@
+/**
+ * Classify Render (or other upstream) health for the Vercel /api/health proxy.
+ * Always map to JSON statuses — never pass HTML through to the client.
+ */
+
+export type UpstreamHealthStatus = "ok" | "warming" | "suspended" | "unavailable";
+
+export type UpstreamHealthPayload = {
+  status: UpstreamHealthStatus;
+  detail: string;
+  version?: string;
+};
+
+function headerGet(
+  headers: Headers | Record<string, string | null | undefined>,
+  name: string
+): string | null {
+  const lower = name.toLowerCase();
+  if (typeof (headers as Headers).get === "function") {
+    return (headers as Headers).get(name) ?? (headers as Headers).get(lower);
+  }
+  const rec = headers as Record<string, string | null | undefined>;
+  for (const [k, v] of Object.entries(rec)) {
+    if (k.toLowerCase() === lower) return v ?? null;
+  }
+  return null;
+}
+
+/** Detect Render administrative suspend (not free-tier sleep). */
+export function isRenderSuspended(
+  headers: Headers | Record<string, string | null | undefined>,
+  bodyText: string
+): boolean {
+  const routing = headerGet(headers, "x-render-routing");
+  if (routing?.toLowerCase() === "suspend") return true;
+  if (/service\s+suspended/i.test(bodyText)) return true;
+  if (/<title>\s*Service Suspended\s*<\/title>/i.test(bodyText)) return true;
+  return false;
+}
+
+/**
+ * Build a JSON health payload from an upstream response.
+ * `httpStatus` is the status code the proxy should return to the browser.
+ */
+export function classifyUpstreamHealth(input: {
+  ok: boolean;
+  status: number;
+  headers: Headers | Record<string, string | null | undefined>;
+  bodyText: string;
+}): { payload: UpstreamHealthPayload; httpStatus: number } {
+  const { ok, status, headers, bodyText } = input;
+
+  if (isRenderSuspended(headers, bodyText)) {
+    return {
+      httpStatus: 503,
+      payload: {
+        status: "suspended",
+        detail:
+          "Demo API is suspended on Render. An operator must resume the service — waiting will not wake it.",
+      },
+    };
+  }
+
+  if (ok) {
+    let version: string | undefined;
+    try {
+      const parsed = JSON.parse(bodyText) as { status?: string; version?: string };
+      if (parsed.version) version = parsed.version;
+      if (parsed.status && parsed.status !== "ok") {
+        return {
+          httpStatus: 503,
+          payload: {
+            status: "unavailable",
+            detail: `Upstream reported status=${parsed.status}`,
+            version,
+          },
+        };
+      }
+    } catch {
+      // Non-JSON 2xx still counts as up for liveness.
+    }
+    return {
+      httpStatus: 200,
+      payload: { status: "ok", detail: "ok", version },
+    };
+  }
+
+  // Free-tier cold start / gateway errors — retry may help.
+  if (status === 502 || status === 503 || status === 504 || status === 0) {
+    return {
+      httpStatus: 503,
+      payload: {
+        status: "warming",
+        detail:
+          "Demo API is slow or waking up (cold start). Retry in up to about a minute.",
+      },
+    };
+  }
+
+  return {
+    httpStatus: 503,
+    payload: {
+      status: "unavailable",
+      detail: `Backend unreachable (HTTP ${status}).`,
+    },
+  };
+}
