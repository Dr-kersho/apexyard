+#!/usr/bin/env bash
+# Dependency-free post-resume / sellable-pilot check.
+# Verifies the Vercel health proxy returns JSON with status "ok".
+#
+# Usage:
+#   ./scripts/verify-pilot-health.sh
+#   PILOT_HEALTH_URL=https://qppv-agent.vercel.app/api/health ./scripts/verify-pilot-health.sh
+#   ./scripts/verify-pilot-health.sh https://qppv-api.onrender.com/health
+set -euo pipefail
+
+URL="${1:-${PILOT_HEALTH_URL:-https://qppv-agent.vercel.app/api/health}}"
+HDR=$(mktemp)
+BODY=$(mktemp)
+trap 'rm -f "$HDR" "$BODY"' EXIT
+
+echo "GET $URL"
+CODE=$(curl -sS -D "$HDR" -o "$BODY" --max-time 90 -w "%{http_code}" "$URL" || true)
+
+CT=$(grep -iE '^content-type:' "$HDR" | head -1 | tr -d '\r' || true)
+echo "HTTP $CODE  $CT"
+
+if grep -qiE '^x-render-routing:[[:space:]]*suspend' "$HDR"; then
+  echo "FAIL: upstream is SUSPENDED on Render (x-render-routing: suspend)."
+  echo "Resume the web service in the Render dashboard, then re-run this script."
+  exit 2
+fi
+
+if grep -qi 'Service Suspended' "$BODY"; then
+  echo "FAIL: body looks like Render Service Suspended HTML (proxy should not pass this through)."
+  head -c 300 "$BODY"
+  echo
+  exit 2
+fi
+
+if ! grep -qi 'application/json' <<<"$CT"; then
+  echo "FAIL: expected application/json Content-Type, got: ${CT:-<missing>}"
+  head -c 300 "$BODY"
+  echo
+  exit 1
+fi
+
+if ! grep -q '"status"[[:space:]]*:[[:space:]]*"ok"' "$BODY"; then
+  echo "FAIL: JSON missing status=ok"
+  cat "$BODY"
+  echo
+  if grep -q '"status"[[:space:]]*:[[:space:]]*"suspended"' "$BODY"; then
+    exit 2
+  fi
+  exit 1
+fi
+
+if [ "$CODE" != "200" ]; then
+  echo "FAIL: expected HTTP 200 with status ok, got $CODE"
+  cat "$BODY"
+  echo
+  exit 1
+fi
+
+echo "PASS: pilot health is sellable (JSON status=ok)."
